<div class="nft-list-editor-wrapper">
    {{#if hint}}
    <p class="nft-list-editor-hint">{{hint}}</p>
    {{/if}}

    <div class="nft-list-editor-add">
        <div class="nft-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" class="nft-search-input nft-list-editor-input" placeholder="Search {{noun}}…" autocomplete="off" spellcheck="false" aria-label="Search {{noun}}">
        </div>
        <button type="button" class="nft-btn secondary nft-list-editor-add-btn" data-action="clearChoices" title="{{clearTitle}}">
            <i class="fa-solid {{clearIcon}}"></i> {{clearLabel}}
        </button>
    </div>

    <div class="nft-list-editor-status">
        <span class="nft-list-editor-count"></span>
    </div>

    {{!-- Groups are rendered by NiksChoicePickerApp#renderChoices --}}
    <div class="nft-status-picker-groups"></div>

    <div class="nft-list-editor-empty" hidden>
        <i class="fa-solid fa-list-check"></i>
        <p></p>
    </div>

    <footer class="nft-dashboard-footer">
        <div class="nft-footer-left">
            <button type="button" class="nft-btn secondary" data-action="resetChoices" title="{{resetTitle}}">
                <i class="fa-solid fa-rotate-left"></i> Reset to Default
            </button>
        </div>
        <div class="nft-footer-right">
            <button type="button" class="nft-btn cancel" data-action="close" title="Discard these changes">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
            <button type="button" class="nft-btn primary" data-action="applyChoices" title="Apply to the dashboard. Use Save Changes there to store it.">
                <i class="fa-solid fa-check"></i> Apply
            </button>
        </div>
    </footer>
</div>
