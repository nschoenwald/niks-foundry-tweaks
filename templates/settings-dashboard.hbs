{{!-- One setting's input. Every setting key appears exactly once in the form, so Save reads it by name. --}}
{{#*inline "nftControl"}}
{{#if (eq this.type "Boolean")}}
<label class="nft-switch">
    <input type="checkbox" id="nft-setting-{{this.key}}" name="{{this.key}}" aria-label="{{this.name}}" {{#if this.value}}checked{{/if}} {{#if this.locked}}disabled{{/if}}>
    <span class="nft-slider"></span>
</label>
{{else if (eq this.type "Select")}}
<select id="nft-setting-{{this.key}}" name="{{this.key}}" class="nft-select" aria-label="{{this.name}}" {{#if this.locked}}disabled{{/if}}>
    {{#each this.choices}}
    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
    {{/each}}
</select>
{{else if (eq this.type "Number")}}
<input type="number" id="nft-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nft-number-input" aria-label="{{this.name}}" {{#if this.locked}}disabled{{/if}}>
{{else if (eq this.type "Color")}}
<div class="nft-color-group">
    <input type="color" id="nft-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nft-color-input" aria-label="{{this.name}}" {{#if this.locked}}disabled{{/if}}>
    <input type="text" name="{{this.key}}-text" value="{{this.value}}" class="nft-color-text" maxlength="7" pattern="#[0-9a-fA-F]{6}" placeholder="#c9a227" aria-label="Hex color" {{#if this.locked}}disabled{{/if}}>
</div>
{{else if (eq this.type "FilePicker")}}
<div class="nft-file-picker-group">
    <input type="text" id="nft-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nft-text-input" aria-label="{{this.name}}" {{#if this.locked}}disabled{{/if}}>
    <button type="button" class="nft-file-picker-btn" data-target="nft-setting-{{this.key}}" data-type="{{this.filePicker}}" data-tooltip="Browse files" aria-label="Browse files" {{#if this.locked}}disabled{{/if}}>
        <i class="fa-solid fa-file-import" inert></i>
    </button>
</div>
{{else if this.list}}
<div class="nft-list-group">
    <input type="hidden" id="nft-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" {{#if this.locked}}disabled{{/if}}>
    {{#if this.statusPicker}}
    <button type="button" class="nft-btn secondary nft-list-edit-btn" data-action="editStatuses" data-key="{{this.key}}" title="Choose which statuses are hidden" {{#if this.locked}}disabled{{/if}}>
        <i class="fa-solid fa-eye-slash" inert></i> Choose <span class="nft-list-count-badge"><span class="nft-list-count">{{this.listCount}}</span>&nbsp;hidden</span>
    </button>
    {{else if this.choicePicker}}
    <button type="button" class="nft-btn secondary nft-list-edit-btn" data-action="editChoices" data-key="{{this.key}}" title="Open the picker" {{#if this.locked}}disabled{{/if}}>
        <i class="fa-solid fa-list-check" inert></i> Choose <span class="nft-list-count-badge"><span class="nft-list-count">{{this.listCount}}</span></span>
    </button>
    {{else}}
    <button type="button" class="nft-btn secondary nft-list-edit-btn" data-action="editList" data-key="{{this.key}}" title="Open the list editor" {{#if this.locked}}disabled{{/if}}>
        <i class="fa-solid fa-list" inert></i> Edit List <span class="nft-list-count-badge"><span class="nft-list-count">{{this.listCount}}</span></span>
    </button>
    {{/if}}
</div>
{{else}}
<input type="text" id="nft-setting-{{this.key}}" name="{{this.key}}" value="{{this.value}}" class="nft-text-input" aria-label="{{this.name}}" {{#if this.locked}}disabled{{/if}}>
{{/if}}
{{/inline}}

{{!-- One option inside an open feature --}}
{{#*inline "nftOption"}}
<div class="nft-setting nft-option nft-depth-{{this.depth}}"
     data-key="{{this.key}}"
     data-scope="{{this.scope}}"
     {{#if this.parentKey}}data-parent="{{this.parentKey}}"{{/if}}
     {{#if this.worldKey}}data-world="{{this.worldKey}}"{{/if}}
     data-search-text="{{this.searchText}}">
    <div class="nft-option-info">
        <div class="nft-option-title">
            <label class="nft-option-name" for="nft-setting-{{this.key}}">{{this.name}}</label>
            <span class="nft-modified-dot" data-tooltip="Changed from the default"></span>
            {{#if this.isNew}}<span class="nft-badge new" data-tooltip="Added in version {{this.introduced}}">New</span>{{/if}}
            {{#if this.requiresReload}}<span class="nft-badge reload" data-tooltip="Takes effect after reloading">Needs reload</span>{{/if}}
        </div>
        {{#if this.hint}}<p class="nft-option-hint">{{this.hint}}</p>{{/if}}
    </div>
    <div class="nft-setting-control">
        {{#if this.canReset}}
        <button type="button" class="nft-row-reset" data-action="resetSetting" data-key="{{this.key}}" data-tooltip="Reset to default{{#if this.defaultLabel}}: {{this.defaultLabel}}{{/if}}" aria-label="Reset to default">
            <i class="fa-solid fa-rotate-left" inert></i>
        </button>
        {{/if}}
        {{> nftControl}}
    </div>
</div>
{{/inline}}

<div class="nft-dashboard-wrapper">
    <header class="nft-dashboard-header">
        <div class="nft-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon" inert></i>
            <input type="search" class="nft-search-input" placeholder="Search features and options… (e.g. prone, damage, toolbar)" autocomplete="off" spellcheck="false" aria-label="Search features and options">
            <button type="button" class="nft-search-clear" data-tooltip="Clear search and filters" aria-label="Clear search and filters" hidden>
                <i class="fa-solid fa-xmark" inert></i>
            </button>
        </div>
        <div class="nft-filter-bar" role="toolbar" aria-label="Show only">
            {{#each filters}}
            <button type="button" class="nft-filter-chip" data-action="toggleFilter" data-filter="{{this.id}}" aria-pressed="false" data-tooltip="{{this.tooltip}}" hidden>
                {{this.label}} <span class="nft-filter-count">0</span>
            </button>
            {{/each}}
        </div>
    </header>

    <div class="nft-dashboard-body">
        <nav class="nft-nav-tabs" aria-label="Categories">
            {{#each navTabs}}
            <button type="button" class="nft-nav-tab {{#if this.active}}active{{/if}}" data-tab="{{this.id}}">
                <i class="{{this.icon}}" inert></i>
                <span class="tab-label">{{this.label}}</span>
                {{#if this.newCount}}<span class="tab-new" data-tooltip="{{this.newCount}} new since you last looked"></span>{{/if}}
                <span class="tab-count" data-tab-count="{{this.id}}"></span>
                <span class="tab-badge" data-tab-matches="{{this.id}}" hidden>0</span>
            </button>
            {{/each}}
        </nav>

        <div class="nft-settings-content">
            {{#unless canModify}}
            <p class="nft-intro">Turn features off or adjust them for yourself. Your choices only affect your own screen.</p>
            {{/unless}}
            {{#if newCount}}
            <div class="nft-new-banner">
                <i class="fa-solid fa-star" inert></i>
                <span>{{newCount}} {{#if (eq newCount 1)}}feature has{{else}}features have{{/if}} something new since you last looked.</span>
                <button type="button" class="nft-link" data-action="toggleFilter" data-filter="new">Show {{#if (eq newCount 1)}}it{{else}}them{{/if}}</button>
            </div>
            {{/if}}

            {{#each tabs}}
            <section class="nft-tab-panel {{#if this.active}}active{{/if}}" data-tab="{{this.id}}">
                <h2 class="nft-tab-title"><i class="{{this.icon}}" inert></i> {{this.label}}</h2>

                {{#each this.sections}}
                <div class="nft-section" data-section="{{this.id}}">
                    <h3 class="nft-section-title"><span>{{this.title}}</span></h3>
                    {{#each this.features}}
                    <article class="nft-feature {{#if this.open}}nft-open{{/if}} {{#if this.unavailable}}nft-unavailable{{/if}}"
                             data-feature="{{this.key}}"
                             data-new="{{#if this.isNew}}true{{else}}false{{/if}}"
                             data-reload="{{#if this.requiresReload}}true{{else}}false{{/if}}"
                             data-search-text="{{this.searchText}}"
                             {{#if this.row}}data-row-key="{{this.row.key}}"{{/if}}
                             {{#if this.primaryKey}}data-primary="{{this.primaryKey}}"{{/if}}>
                        <div class="nft-feature-row">
                            <button type="button" class="nft-feature-toggle" data-action="toggleFeature" aria-expanded="{{#if this.open}}true{{else}}false{{/if}}" aria-controls="nft-panel-{{this.key}}">
                                <span class="nft-feature-title">
                                    <i class="fa-solid fa-chevron-right nft-caret" inert></i>
                                    <span class="nft-feature-name">{{this.name}}</span>
                                    <span class="nft-modified-dot" data-tooltip="Changed from the default"></span>
                                    {{#if this.isNew}}<span class="nft-badge new">New</span>{{/if}}
                                    {{#if this.unavailable}}<span class="nft-badge unavailable" data-tooltip="{{this.unavailableReason}}"><i class="fa-solid fa-ban" inert></i> {{this.unavailableLabel}} handles this</span>{{/if}}
                                    {{#if this.requiresReload}}<span class="nft-badge reload" data-tooltip="Takes effect after reloading">Needs reload</span>{{/if}}
                                    {{#if this.personalOnly}}{{#if @root.canModify}}<span class="nft-badge personal" data-tooltip="Each user sets this for their own screen">Just for you</span>{{/if}}{{/if}}
                                    <span class="nft-badge personal-off" data-tooltip="You turned this off for your own screen" hidden>Off for you</span>
                                    {{#if this.optionCount}}<span class="nft-option-count">{{this.optionCount}} {{#if (eq this.optionCount 1)}}option{{else}}options{{/if}}</span>{{/if}}
                                </span>
                                <span class="nft-feature-summary">{{this.summary}}</span>
                            </button>
                            <div class="nft-feature-control">
                                {{#with this.row}}
                                <div class="nft-setting nft-row-setting" data-key="{{this.key}}" data-scope="{{this.scope}}" {{#if this.worldKey}}data-world="{{this.worldKey}}"{{/if}}>
                                    {{> nftControl}}
                                </div>
                                {{/with}}
                            </div>
                        </div>

                        <div class="nft-feature-panel" id="nft-panel-{{this.key}}">
                            {{#if this.hint}}<p class="nft-feature-hint">{{this.hint}}</p>{{/if}}
                            {{#if this.unavailable}}<p class="nft-lock-note"><i class="fa-solid fa-ban" inert></i> {{this.unavailableReason}}</p>{{/if}}

                            {{#if this.options.length}}
                            <section class="nft-option-group" data-group="world">
                                <h4>Options for everyone <span class="nft-group-note nft-when-off">Turn the feature on to change these</span></h4>
                                {{#each this.options}}{{> nftOption}}{{/each}}
                            </section>
                            {{/if}}

                            {{#if this.personal.length}}
                            <section class="nft-option-group nft-personal-group" data-group="personal">
                                <h4>On your screen <span class="nft-group-note">{{#if @root.canModify}}Each player sets this for themselves{{else}}Only affects you{{/if}}</span></h4>
                                {{#each this.personal}}{{> nftOption}}{{/each}}
                            </section>
                            {{/if}}

                            <footer class="nft-feature-footer">
                                {{#if this.moduleTitle}}<span>From {{this.moduleTitle}}</span>{{/if}}
                                {{#if this.docsUrl}}<a class="nft-docs-link" href="{{this.docsUrl}}" target="_blank" rel="noopener"><i class="fa-solid fa-book-open" inert></i> Read the docs</a>{{/if}}
                                {{#if this.canReset}}<button type="button" class="nft-link nft-feature-reset" data-action="resetFeature" data-feature="{{this.key}}"><i class="fa-solid fa-rotate-left" inert></i> Reset this feature</button>{{/if}}
                            </footer>
                        </div>
                    </article>
                    {{/each}}
                </div>
                {{/each}}

                {{#if this.alsoActive.length}}
                <details class="nft-also-active">
                    <summary>Also active in this world: {{this.alsoActive.length}} {{#if (eq this.alsoActive.length 1)}}feature{{else}}features{{/if}} the GM runs for everyone</summary>
                    <ul>{{#each this.alsoActive}}<li><strong>{{this.name}}</strong> {{this.summary}}</li>{{/each}}</ul>
                </details>
                {{/if}}
            </section>
            {{/each}}

            <div class="nft-no-results" hidden>
                <i class="fa-solid fa-filter-circle-xmark" inert></i>
                <p>No features match your search and filters.</p>
                <button type="button" class="nft-btn-clear-search">Clear Search &amp; Filters</button>
            </div>
        </div>
    </div>

    <footer class="nft-dashboard-footer">
        <div class="nft-footer-left">
            <div class="nft-more-menu">
                <button type="button" class="nft-btn secondary nft-more-toggle" data-action="toggleMore" aria-expanded="false" aria-haspopup="menu">
                    <i class="fa-solid fa-ellipsis" inert></i> More
                </button>
                <div class="nft-more-pop" role="menu" hidden>
                    <button type="button" role="menuitem" data-action="exportSettings"><i class="fa-solid fa-download" inert></i> Export settings…</button>
                    <button type="button" role="menuitem" data-action="importSettings" {{#unless canModify}}disabled{{/unless}}><i class="fa-solid fa-upload" inert></i> Import settings…</button>
                    <button type="button" role="menuitem" data-action="resetDefaults"><i class="fa-solid fa-rotate-left" inert></i> {{#if canModify}}Reset everything to defaults…{{else}}Reset my choices to defaults…{{/if}}</button>
                </div>
            </div>
            <input type="file" class="nft-file-import-input" accept=".json" style="display: none;">
        </div>
        <div class="nft-footer-right">
            <span class="nft-pending-note" hidden></span>
            <button type="button" class="nft-btn cancel" data-action="close">
                <i class="fa-solid fa-xmark" inert></i> Cancel
            </button>
            <button type="submit" class="nft-btn primary">
                <i class="fa-solid fa-floppy-disk" inert></i> Save <span class="nft-save-count" hidden>0</span>
            </button>
        </div>
    </footer>
</div>
